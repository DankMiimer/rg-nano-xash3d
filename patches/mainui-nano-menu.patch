+void CMenuMain::NanoArrange(bool style)
+{
+    // Native Nano profile: original button images/font, larger readable rows.
+    CMenuPicButton *rows[] = { &console, &disconnect, &resumeGame, &newGame,
+        &hazardCourse, &configuration, &saveRestore, &multiPlayer,
+        &customGame, &previews, &quit };
+    const bool nano = ScreenWidth <= 320 && EngFuncs::GetCvarFloat("nano_hud_profile");
+    console.SetVisibility(gpGlobals->developer != 0 && !nano);
+    nanoLayout = nano;
+    banner.SetVisibility(!nano);
+    movieBanner.SetVisibility(!nano);
+    animatedBanner.SetVisibility(!nano);
+    if (nano) {
+        // Avoid negative child coordinates: they anchor from the parent's bottom.
+        SetCoord(0, 0);
+        SetSize((int)ceilf(ScreenWidth/uiStatic.scaleX), (int)ceilf(ScreenHeight/uiStatic.scaleY));
+        CalcPosition(); CalcSizes();
+    }
+    int row = 0, visible = 0;
+    for (unsigned i = 0; i < sizeof(rows)/sizeof(rows[0]); ++i) if (rows[i]->Parent() == this && rows[i]->IsVisible()) ++visible;
+    float rowPixels = visible ? (ScreenHeight - 16.0f) / visible : 22.0f;
+    if (rowPixels > 22.0f) rowPixels = 22.0f;
+    for (unsigned i = 0; i < sizeof(rows)/sizeof(rows[0]); ++i) {
+        if (style) rows[i]->SetNanoScale(nano ? 2.0f : 1.0f);
+        if (nano && rows[i]->Parent() == this && rows[i]->IsVisible()) {
+            const int gap = (int)(rowPixels / uiStatic.scaleY);
+            rows[i]->SetCoord(50, (int)ceilf(8.0f / uiStatic.scaleY) + row * gap);
+            rows[i]->CalcPosition();
+            rows[i]->CalcSizes();
+            ++row;
+        }
+    }
+
+}
