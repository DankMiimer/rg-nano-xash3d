+void CMenuPicButton::SetNanoScale(float scale)
+{
+    if (!(scale >= 1 && scale <= 3)) scale = 1;
+    SetCharSize(QM_DEFAULTFONT);
+    charSize = (int)(charSize * scale);
+    // Vector-font builds ignore DrawString's charH unless SCALE_FONTS is enabled.
+    // Rasterize the same font at its target size; CFontBuilder reuses matching fonts.
+    if (scale > 1) {
+        static HFont cached = 0;
+        static CBaseFont *cachedObject = NULL;
+        static int cachedTall = 0;
+        int tall = (int)(charSize*uiStatic.scaleY+0.5f);
+        if (!cachedObject || cachedTall != tall || g_FontMgr->GetIFontFromHandle(cached) != cachedObject) {
+            cached = CFontBuilder("Trebuchet MS", tall, 500).Create();
+            cachedObject = g_FontMgr->GetIFontFromHandle(cached);
+            cachedTall = tall;
+        }
+        font = cached;
+    }
+    size = Size((int)(uiStatic.buttons_draw_size.w * scale),
+        (int)(uiStatic.buttons_draw_size.h * scale));
+}
