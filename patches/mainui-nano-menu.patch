+bool CMenuFramework::NanoSettingsActive() const
+{
+    return nanoSettings && ScreenWidth <= 320 && EngFuncs::GetCvarFloat("nano_hud_profile");
+}
+
+void CMenuFramework::NanoArrangeSettings()
+{
+    if (!NanoSettingsActive()) return;
+    // Root coordinates cover the full square screen; rows use physical-pixel dimensions.
+    SetCoord(0, 0);
+    SetSize((int)ceilf(ScreenWidth/uiStatic.scaleX), (int)ceilf(ScreenHeight/uiStatic.scaleY));
+    CalcPosition(); CalcSizes();
+    banner.Hide();
+    DisableTransition();
+    CMenuBaseItem *rows[64];
+    int heights[64], count=0, total=0, focusTop=-1, focusHeight=0;
+    for (int i=0; i<ItemCount() && count<64; ++i) {
+        CMenuBaseItem *item=GetItemByIndex(i);
+        if (item==&banner || !item->IsVisible()) continue;
+        bool button=item->NanoRowType()==NANO_ROW_BUTTON;
+        bool slider=item->NanoRowType()==NANO_ROW_SLIDER;
+        bool spin=item->NanoRowType()==NANO_ROW_SPIN;
+        bool check=item->NanoRowType()==NANO_ROW_CHECK;
+        bool table=item->NanoRowType()==NANO_ROW_TABLE;
+        bool action=item->NanoRowType()==NANO_ROW_ACTION;
+        if (!(button || slider || spin || check || table || action)) {
+            // Decorative previews do not compete with full-width settings controls.
+            if (item->iFlags & QMF_INACTIVE) item->iFlags |= QMF_HIDDENBYPARENT;
+            continue;
+        }
+        item->iFlags &= ~QMF_NOTIFY;
+        item->SetNanoFont();
+        int height=table ? 142 : (slider || spin) ? 42 : 24;
+        if (item==ItemAtCursor()) { focusTop=total; focusHeight=height; }
+        rows[count]=item; heights[count++]=height; total+=height;
+    }
+    // Show() initially selects the old banner slot; select a real control instead.
+    if (focusTop<0) {
+        int rowTop=0;
+        for (int i=0; i<count; ++i) {
+            if (!(rows[i]->iFlags & (QMF_INACTIVE|QMF_GRAYED))) {
+                SetCursorToItem(*rows[i]); focusTop=rowTop; focusHeight=heights[i]; break;
+            }
+            rowTop+=heights[i];
+        }
+    }
+    int viewport=ScreenHeight-30;
+    if (focusTop>=0) {
+        if (focusTop<nanoScroll) nanoScroll=focusTop;
+        if (focusTop+focusHeight>nanoScroll+viewport) nanoScroll=focusTop+focusHeight-viewport;
+    }
+    nanoScroll=bound(0,nanoScroll,Q_max(0,total-viewport));
+    int top=8-nanoScroll;
+    for (int i=0; i<count; ++i) {
+        CMenuBaseItem *item=rows[i];
+        bool slider=item->NanoRowType()==NANO_ROW_SLIDER;
+        bool spin=item->NanoRowType()==NANO_ROW_SPIN;
+        bool check=item->NanoRowType()==NANO_ROW_CHECK;
+        bool table=item->NanoRowType()==NANO_ROW_TABLE;
+        bool visible=top>=8 && top+heights[i]<=ScreenHeight-22;
+        if (visible) item->iFlags &= ~QMF_HIDDENBYPARENT;
+        else item->iFlags |= QMF_HIDDENBYPARENT;
+        int y=visible ? top+(slider || spin ? 18 : 0) : 8;
+        int width=check ? 14 : ScreenWidth-20;
+        int height=check ? 14 : table ? heights[i]-6 : slider || spin ? 16 : 20;
+        Point position((int)ceilf(10.0f/uiStatic.scaleX), (int)ceilf(y/uiStatic.scaleY));
+        Size extent((int)ceilf(width/uiStatic.scaleX),(int)ceilf(height/uiStatic.scaleY));
+        if (item->pos.x!=position.x || item->pos.y!=position.y || item->size.w!=extent.w || item->size.h!=extent.h) {
+            item->pos=position; item->size=extent;
+            item->VidInit();
+        }
+        top+=heights[i];
+    }
+}
