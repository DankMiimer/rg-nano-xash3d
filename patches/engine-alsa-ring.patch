@@ -310,6 +267,28 @@ Callback provided by the engine in case we need it.  We don't.
 */
 void SNDDMA_BeginPainting(void)
 {
+	if( !snd.initialized || s_alsa.paused || !snd.samples ) return;
+	snd_pcm_sframes_t delay = 0;
+	int err = snd_pcm_delay( s_alsa.pcm_handle, &delay );
+	if( err < 0 && err != -EPIPE && err != -ESTRPIPE ) return;
+	if( err < 0 || delay < 0 ) delay = 0;
+	unsigned long long pending = (unsigned long long)delay;
+	unsigned long long played = s_alsa.frames_written > pending ? s_alsa.frames_written - pending : 0;
+	qboolean rebased = false;
+	// Use an absolute mixer clock: a slow frame can consume an entire ring.
+	// Modulo-only wrap detection would then stall the mixer permanently.
+	if( snd.paintedtime > 0x40000000 )
+	{
+		unsigned long long ring = snd.samples / 2;
+		unsigned long long offset = played > ring ? (played / ring - 1) * ring : 0;
+		s_alsa.frames_written -= offset;
+		snd.paintedtime -= offset;
+		played -= offset;
+		rebased = offset != 0;
+	}
+	snd.soundtime = played;
+	snd.samplepos = (played % (snd.samples / 2)) * 2;
+	if( rebased ) S_StopAllSounds( true );
 }
 
