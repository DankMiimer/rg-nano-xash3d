+// A same-map reload can retain brush surfaces after the decal pool is reset.
+// Drop every model's surface heads so restored pool entries cannot self-link.
+static void R_ClearSurfaceDecals( void )
+{
+	for( int i = 1; i < gp_cl->nummodels; i++ )
+	{
+		model_t *model = CL_ModelHandle( i );
+		if( !model || model->type != mod_brush || model->name[0] == '*' )
+			continue;
+
+		for( int j = 0; j < model->numsurfaces; j++ )
+			model->surfaces[j].pdecals = NULL;
+	}
+}
