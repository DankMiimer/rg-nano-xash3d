+int CHudSpectatorGui::NanoEntries(const char **names,const char **commands)
+{
+    static const char *rootNames[]={"Options","Previous player","Next player","Camera mode","Close"};
+    static const char *rootCommands[]={"_spec_toggle_menu_options","_spec_find_next_player_reverse","_spec_find_next_player","_spec_toggle_menu_spectate_options","_spec_toggle_menu"};
+    static const char *cameraNames[]={"Chase map overview","Free map overview","First person","Free look","Free chase camera","Locked chase camera","Back"};
+    static const char *cameraCommands[]={"spec_mode 6","spec_mode 5","spec_mode 4","spec_mode 3","spec_mode 2","spec_mode 1","_spec_toggle_menu_spectate_options"};
+    static const char *optionNames[]={"Settings","Autodirector","Show scores","Picture-in-picture (off)","Help","Back"};
+    static const char *optionCommands[]={"_spec_toggle_menu_options_settings","spec_autodirector t","showscoreboard2","","spec_help","_spec_toggle_menu_options"};
+    static const char *settingNames[]={"Chat messages","Show status","View cone","Player names","Back"};
+    static const char *settingCommands[]={"hud_saytext t","spec_drawstatus t","spec_drawcone t","spec_drawnames t","_spec_toggle_menu_options_settings"};
+    const char **n=rootNames,**c=rootCommands;int count=5;
+    if(m_menuFlags&MENU_SPEC_OPTIONS){n=cameraNames;c=cameraCommands;count=7;}
+    else if(m_menuFlags&MENU_OPTIONS_SETTINGS){n=settingNames;c=settingCommands;count=5;}
+    else if(m_menuFlags&MENU_OPTIONS){n=optionNames;c=optionCommands;count=6;}
+    for(int i=0;i<count;i++){names[i]=n[i];commands[i]=c[i];}return count;
+}
+int CHudSpectatorGui::NanoDraw()
+{
+    NanoHudScope scope(1.0f,0,0);
+    int h=NanoHudTextHeight(),r=255,g=140,b=0;
+    FillRGBABlend(0,0,ScreenWidth,2*h+12,0,0,0,153);
+    char summary[128],map[128];
