+        else strcpy(health,"HP -");
+        if(g_PlayerExtraInfo[id].sb_account>=0)snprintf(money,sizeof(money),"$%d",g_PlayerExtraInfo[id].sb_account);else strcpy(money,"$-");
+        snprintf(entry,sizeof(entry),"%s %s %s p%d",health,money,g_PlayerExtraInfo[id].has_c4?"C4":g_PlayerExtraInfo[id].vip?"VIP":g_PlayerExtraInfo[id].has_defuse_kit?"kit":"",g_PlayerInfoList[id].ping);
+        NanoHudFit(entry,detail,sizeof(detail),ScreenWidth-16,NanoScoreWidth);
