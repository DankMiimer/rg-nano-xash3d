+}
+int CHudScoreboard::NanoKey(int down,int key)
+{
+    if(!NanoHudActive() || !ShouldDrawScoreboard())return 0;
+    if(key==K_BACKSPACE && m_bForceDraw){if(down){m_bForceDraw=false;gEngfuncs.Cvar_SetValue("nano_scoreboard",0);}return 1;}
+    if(key!=K_LEFTARROW && key!=K_RIGHTARROW && key!=K_UPARROW && key!=K_DOWNARROW)return 0;
+    if(down)nanoPage+=key==K_LEFTARROW || key==K_UPARROW?-1:1;
+    if(nanoPage<0)nanoPage=0;return 1;
+}
