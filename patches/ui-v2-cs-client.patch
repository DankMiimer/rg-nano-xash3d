+    NanoHudFit(label.m_szMap,map,sizeof(map),ScreenWidth-8,NanoSpectatorWidth);
+    // Map remains available in the scoreboard; team scores occupy this row.
+    FillRGBABlend(0,ScreenHeight-2*h-12,ScreenWidth,2*h+12,0,0,0,153);
+    if(g_iUser2>0 && g_iUser2<=MAX_PLAYERS) {
+        hud_player_info_t player;GetPlayerInfo(g_iUser2,&player);
+        char name[128],health[32];NanoHudFit(player.name?player.name:"",name,sizeof(name),ScreenWidth-8,NanoSpectatorWidth);
+        int value=g_PlayerExtraInfo[g_iUser2].sb_health>255?g_PlayerExtraInfo[g_iUser2].sb_health:g_PlayerExtraInfo[g_iUser2].health;
+        snprintf(health,sizeof(health),"Health: %d",value);GetTeamColor(r,g,b,g_PlayerExtraInfo[g_iUser2].teamnumber);
+        DrawUtils::DrawHudString(4,ScreenHeight-2*h-8,ScreenWidth-4,name,r,g,b);
+        DrawUtils::DrawHudString(4,ScreenHeight-h-4,ScreenWidth-4,health,r,g,b);
+    }
+    if(m_menuFlags&ROOT_MENU) {
+        gEngfuncs.Cvar_SetValue("nano_text_menu",1);
+        const char *names[8],*commands[8];int count=NanoEntries(names,commands);
+        nanoCursor=bound(0,nanoCursor,count-1);int pitch=h+10,visible=(ScreenHeight-16)/pitch;
+        int first=max(0,nanoCursor-visible+1);first=min(first,max(0,count-visible));
+        FillRGBABlend(4,4,ScreenWidth-8,ScreenHeight-8,0,0,0,230);
+        for(int row=first,y=8;row<count && row<first+visible;row++,y+=pitch) {
+            if(row==nanoCursor)FillRGBABlend(8,y-2,ScreenWidth-16,pitch,90,60,0,180);
+            DrawUtils::DrawHudString(12,y,ScreenWidth-12,names[row],commands[row][0]?255:100,commands[row][0]?140:100,commands[row][0]?0:100);
+        }
+    }
+    return 1;
+}
+int CHudSpectatorGui::NanoKey(int down,int key)
+{
+    if(!NanoHudActive() || !(m_menuFlags&ROOT_MENU))return 0;
+    if(key!=K_UPARROW && key!=K_DOWNARROW && key!=K_LEFTARROW && key!=K_RIGHTARROW && key!=K_ENTER && key!=K_BACKSPACE)return 0;
+    if(!down)return 1;
+    const char *names[8],*commands[8];int count=NanoEntries(names,commands);
+    if(key==K_BACKSPACE) {
+        if(m_menuFlags&MENU_SPEC_OPTIONS)UserCmd_ToggleSpectatorMenuSpectateOptions();
+        else if(m_menuFlags&MENU_OPTIONS_SETTINGS)UserCmd_ToggleSpectatorMenuOptionsSettings();
+        else if(m_menuFlags&MENU_OPTIONS)UserCmd_ToggleSpectatorMenuOptions();
+        else UserCmd_ToggleSpectatorMenu();
+    } else if(key==K_ENTER) {
+        if(commands[nanoCursor][0])gEngfuncs.pfnClientCmd((char *)commands[nanoCursor]);
+    } else {
+        int step=key==K_UPARROW || key==K_LEFTARROW?-1:1;
+        do nanoCursor=(nanoCursor+step+count)%count;while(!commands[nanoCursor][0]);
+    }
+    return 1;
+}
