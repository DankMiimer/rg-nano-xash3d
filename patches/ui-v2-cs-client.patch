+    for(int i=1;i<count;i++)for(int j=i;j>0;j--) {
+        int a=players[j-1],b=players[j];
+        if(g_PlayerExtraInfo[a].frags>g_PlayerExtraInfo[b].frags ||
+          (g_PlayerExtraInfo[a].frags==g_PlayerExtraInfo[b].frags && g_PlayerExtraInfo[a].deaths<=g_PlayerExtraInfo[b].deaths))break;
+        players[j-1]=b;players[j]=a;
+    }
+    int h=NanoHudTextHeight(),pitch=2*h+8,visible=(ScreenHeight-2*h-38)/pitch;
+    int pages=max(1,(count+visible-1)/visible);nanoPage=bound(0,nanoPage,pages-1);
+    FillRGBABlend(4,4,ScreenWidth-8,ScreenHeight-8,0,0,0,210);
+    char title[128];NanoHudFit(gHUD.m_szServerName[0]?gHUD.m_szServerName:"Scoreboard",title,sizeof(title),ScreenWidth-8,NanoScoreWidth);
+    DrawUtils::DrawHudString(8,8,ScreenWidth-8,title,255,140,0);
+    const char *level=gEngfuncs.pfnGetLevelName(),*base=strrchr(level,'/');if(base)level=base+1;
+    char map[128];NanoHudFit(level,map,sizeof(map),ScreenWidth-16,NanoScoreWidth);
+    DrawUtils::DrawHudString(8,h+12,ScreenWidth-8,map,190,190,190);
+    for(int row=nanoPage*visible,y=2*h+18;row<count && row<(nanoPage+1)*visible;row++,y+=pitch) {
+        int id=players[row],r=255,g=140,b=0;char name[128],score[40],detail[128],entry[192];
+        GetTeamColor(r,g,b,g_PlayerExtraInfo[id].teamnumber);
+        snprintf(score,sizeof(score),"%d/%d",g_PlayerExtraInfo[id].frags,g_PlayerExtraInfo[id].deaths);
+        int nameWidth=ScreenWidth-24-DrawUtils::HudStringLen(score);
+        snprintf(entry,sizeof(entry),"%s %s",g_PlayerExtraInfo[id].teamnumber==TEAM_CT?"CT":g_PlayerExtraInfo[id].teamnumber==TEAM_TERRORIST?"T":"S",g_PlayerInfoList[id].name);
+        NanoHudFit(entry,name,sizeof(name),nameWidth,NanoScoreWidth);
+        if(id==m_iPlayerNum)FillRGBABlend(6,y-2,ScreenWidth-12,pitch,60,60,30,120);
+        DrawUtils::DrawHudString(8,y,ScreenWidth-8,name,r,g,b);
