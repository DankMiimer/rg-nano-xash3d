+
+// Normalize only client HUD fonts; console/menu rendering keeps its own metrics.
+static int NanoHudFontHeight(cl_font_t *font,int flags)
+{
+    if(FBitSet(flags,FONT_DRAW_HUD) && Cvar_VariableValue("nano_hud_profile")) {
+        int height=Cvar_VariableValue("nano_hud_text_height");
+        return height>=12 && height<=18 ? height : 14;
+    }
+    return font->charHeight;
+}
+static int NanoHudFontWidth(cl_font_t *font,int number,int flags)
+{
+    float scale=font->charHeight ? (float)NanoHudFontHeight(font,flags)/font->charHeight : 1;
+    return Q_rint(font->charWidths[number&255]*scale);
+}
