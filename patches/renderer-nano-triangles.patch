+static void TriDrawTriangle( finalvert_t *a, finalvert_t *b, finalvert_t *c )
+{
+	// The rasterizer accepts one winding. Mirroring a weapon reverses it;
+	// TRI_NONE must accept either winding for overview tiles and sprites.
+	if( ds.cullFace == TRI_NONE )
+	{
+		R_RenderTriangle( a, b, c );
+		R_RenderTriangle( c, b, a );
+	}
+	else if( tr.fFlipViewModel )
+		R_RenderTriangle( c, b, a );
+	else
+		R_RenderTriangle( a, b, c );
+}
