 	return true;
 }
 
+#if XASH_POSIX && !XASH_DEDICATED
+/*
+=================
+Host_NanoPowerFrame
+
+FunKey OS sends SIGUSR1 when the console powers off (FunKey S lid, RG Nano
+power button). Save single-player progress for the launcher to resume, let
+the save preview render, then quit normally so settings are written too.
+=================
+*/
+static void Host_NanoPowerFrame( void )
+{
+	static int frames;
+	static double started;
+
+	if( nano_power_request == 1 )
+	{
+		const char *flag = getenv( "NANO_POWER_FLAG" );
+
+		nano_power_request = 2;
+		frames = 0;
+		started = Platform_DoubleTime();
+		Con_Printf( "nano-power: power-off requested\n" );
+
+		if( SV_Active() && SV_SaveGame( "nano_poweroff" ))
+		{
+			Con_Printf( "nano-power: saved nano_poweroff\n" );
+			if( !COM_StringEmptyOrNULL( flag ))
+			{
+				FILE *f = fopen( flag, "w" );
+				if( f ) fclose( f );
+			}
+			return;
+		}
+
+		nano_power_request = 3;
+		Cbuf_AddText( "quit\n" );
+	}
+	else if( nano_power_request == 2 && ++frames >= 4 && Platform_DoubleTime() - started >= 0.25 )
+	{
+		nano_power_request = 3;
+		Cbuf_AddText( "quit\n" );
+	}
+}
+#endif
+
