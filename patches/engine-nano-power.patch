--- a/engine/platform/posix/sys_posix.c
+++ b/engine/platform/posix/sys_posix.c
@@ -86,6 +86,25 @@
 
 }
 
+volatile sig_atomic_t nano_power_request;
+
+static void Posix_NanoPowerCallback( int signal )
+{
+	if( !nano_power_request )
+		nano_power_request = 1;
+}
+
+// The client build installs no signal handlers of its own, so without this
+// SIGUSR1 would simply kill the game. Restart interrupted calls (audio, files).
+void Posix_SetupNanoPowerHandling( void )
+{
+	struct sigaction act = { 0 };
+	act.sa_handler = Posix_NanoPowerCallback;
+	sigemptyset( &act.sa_mask );
+	act.sa_flags = SA_RESTART;
+	sigaction( SIGUSR1, &act, NULL );
+}
