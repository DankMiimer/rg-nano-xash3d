+static void *NanoTextureAlloc( size_t bytes )
+{
+    return Mem_Calloc( r_temppool, bytes );
+}
+
+static void NanoTextureFree( void *data )
+{
+    Mem_Free( data );
+}
+
+static NanoTextureShare nanoTextureShare = {
+    .alloc = NanoTextureAlloc, .free = NanoTextureFree
+};
+
+static void R_NanoTextureReport_f( void )
+{
+    const NanoTextureShare *s = &nanoTextureShare;
+    fprintf( stderr, "nano-textures: logical_bytes=%zu unique_bytes=%zu saved_bytes=%zu metadata_bytes=%zu buffers=%zu references=%zu\n",
+        s->logical_bytes, s->unique_bytes, s->logical_bytes - s->unique_bytes,
+        s->buffers * sizeof( NanoTextureBuffer ), s->buffers, s->references );
+}
 
