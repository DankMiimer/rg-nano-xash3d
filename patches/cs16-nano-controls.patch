+int CHudMenu::NanoKey(int down,int key)
+{
+    if(key!=K_UPARROW && key!=K_DOWNARROW && key!=K_LEFTARROW && key!=K_RIGHTARROW && key!=K_ENTER && key!=K_BACKSPACE)return 0;
+    if(!down)return 1;
+    if(key==K_BACKSPACE) {
+        if(m_bitsValidSlots&(1<<9))SelectMenuItem(10);
+        return 1;
+    }
+    if(key==K_ENTER) {
+        m_nanoSelection=NanoMenuSelection(m_bitsValidSlots,m_nanoSelection,0);
+        if(m_nanoSelection)SelectMenuItem(m_nanoSelection);
+    } else m_nanoSelection=NanoMenuSelection(m_bitsValidSlots,m_nanoSelection,(key==K_UPARROW || key==K_LEFTARROW)?-1:1);
+    return 1;
+}
