 Mem_Stats_f
 ===============
 */
+
+/* Counter-only snapshot: no allocation-chain walks or integrity checks. */
+void Mem_NanoReport_f( void )
+{
+    size_t total = 0, real = 0, count = 0, emitted = 0;
+    for( size_t i = 0; i < poolcount; i++ )
+    {
+        const mempool_t *pool = &poolchain[i];
+        if( !pool->filename ) continue;
+        count++;
+        total += pool->totalsize;
+        real += pool->realsize;
+    }
+    fprintf( stderr, "nano-memory: pools=%zu bytes=%zu allocated_bytes=%zu\n", count, total, real );
+    /* Print at most sixteen largest nonempty pools, stable by pool index. */
+    size_t previous = 0, previousSize = (size_t)-1;
+    qboolean havePrevious = false;
+    while( emitted < 16 )
+    {
+        size_t best = poolcount, bestSize = 0;
+        for( size_t i = 0; i < poolcount; i++ )
+        {
+            const mempool_t *pool = &poolchain[i];
+            if( !pool->filename || !pool->totalsize ) continue;
+            if( havePrevious && (pool->totalsize > previousSize ||
+                (pool->totalsize == previousSize && i <= previous)) ) continue;
+            if( best == poolcount || pool->totalsize > bestSize )
+                best = i, bestSize = pool->totalsize;
+        }
+        if( best == poolcount ) break;
+        const mempool_t *pool = &poolchain[best];
+        fprintf( stderr, "nano-memory-pool: bytes=%zu allocated_bytes=%zu name=%s\n",
+            pool->totalsize, pool->realsize, pool->name );
+        previous = best;
+        previousSize = bestSize;
+        havePrevious = true;
+        emitted++;
+    }
+}
+
 void Mem_Stats_f( void )
 {
 	switch( Cmd_Argc( ))
