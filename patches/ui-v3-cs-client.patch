+int CHudProgressBar::MsgFunc_BotProgress(const char *pszName,int iSize,void *pbuf)
+{
+    BufferReader reader(pszName,pbuf,iSize);int flag=reader.ReadByte();
+    int percent=flag==UPDATE_BOTPROGRESS?reader.ReadByte():0;
+    const char *title=(flag==CREATE_BOTPROGRESS || flag==UPDATE_BOTPROGRESS)?reader.ReadString():"";
+    m_iDuration=0;
+    if(flag==CREATE_BOTPROGRESS)m_fPercent=0;
+    else if(flag==UPDATE_BOTPROGRESS)m_fPercent=max(m_fPercent,percent/100.0f);
+    if(flag==CREATE_BOTPROGRESS || flag==UPDATE_BOTPROGRESS){
+        strncpy(m_szHeader,title,sizeof(m_szHeader)-1);m_szHeader[sizeof(m_szHeader)-1]=0;
+        m_szLocalizedHeader=m_szHeader[0]=='#'?Localize(m_szHeader+1):m_szHeader;m_iFlags=HUD_DRAW;
+    } else {m_fPercent=0;m_szHeader[0]=0;m_szLocalizedHeader=NULL;m_iFlags=0;}
+    nanoLoading.Message(flag,percent,title);
+    gEngfuncs.Cvar_SetValue("nano_bot_loading",NanoHudActive() && nanoLoading.active);
+    return 1;
+}
+
+int CHudProgressBar::NanoDrawLoading(float time)
+{
+    // An opaque, persistent screen keeps transient stage updates from exposing laggy gameplay.
+    FillRGBABlend(0,0,ScreenWidth,ScreenHeight,20,20,20,255);
+    char heading[]="Preparing bots",stage[96],detail[96];
+    const char *names[]={"","Exploring the map","Finding hiding spots","Planning routes"};
+    snprintf(stage,sizeof(stage),"%d/3  %s",nanoLoading.stage,names[nanoLoading.stage]);
+    DrawUtils::DrawHudString(12,68,ScreenWidth-12,heading,255,140,0);
+    DrawUtils::DrawHudString(12,104,ScreenWidth-12,stage,220,220,220);
+    int width=ScreenWidth-24,x=12,y=144;DrawUtils::DrawRectangle(x,y,width,12);
+    if(nanoLoading.stage==1) {
+        int span=max(8,(width-4)/9),offset=(int)(time*24)%max(1,(width-4)/3-span);
+        FillRGBA(x+2+offset,y+2,span,8,255,140,0,255);
+        strcpy(detail,"Exploration in progress");
+    } else {
+        FillRGBA(x+2,y+2,(int)((width-4)*nanoLoading.progress),8,255,140,0,255);
+        snprintf(detail,sizeof(detail),"%d%% overall",(int)(nanoLoading.progress*100));
+    }
+    DrawUtils::DrawHudString(12,174,ScreenWidth-12,detail,190,190,190);
+    return 1;
+}
