+static NanoControlState nanoControls = { 0, 0, 0, -1, 0 };
+static int NanoControlContext(void)
+{
+    if(cls.key_dest == key_game && cls.state == ca_active)
+        return nano_text_menu.value ? 2 : 1;
+    return 0;
+}
+static void NanoControlKey(int action,int down,void *opaque)
+{
+    (void)opaque;
+    int key=K_AUX1+action-1;
+    switch(action) {
+    case NC_SLOW:Cvar_SetValue("nano_look_slow",down?1:0);return;
+    case NC_UIUP:key=K_UPARROW;break;
+    case NC_UIDOWN:key=K_DOWNARROW;break;
+    case NC_UILEFT:key=K_LEFTARROW;break;
+    case NC_UIRIGHT:key=K_RIGHTARROW;break;
+    case NC_CONFIRM:key=K_ENTER;break;
+    case NC_CANCEL:key=nanoControls.context==2?K_BACKSPACE:K_ESCAPE;break;
+    }
+    Key_Event(key,down);
+}
 
