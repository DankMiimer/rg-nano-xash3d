+void CMenuLoadGame::NanoUnloadPreviews()
+{
+    for(int i=0;i<3;++i){nanoThumb[i].ForceUnload();nanoThumb[i].Reset();nanoThumbName[i][0]=0;}
+}
+void CMenuLoadGame::Hide()
+{
+    NanoUnloadPreviews();BaseClass::Hide();
+}
+void CMenuLoadGame::NanoRequestSave()
+{
+    int index=savesList.GetCurrentIndex();
+    if(!CL_IsActive() || gpGlobals->maxClients>1 || !savesListModel.IsValidIndex(index))return;
+    const char *name=savesListModel[index].name;
+    if(!NanoSaveNameValid(name))return;
+    Q_strncpy(nanoTarget,name,sizeof(nanoTarget));
+    if(!strcmp(name,"new")){NanoCommitSave();return;}
+    snprintf(nanoPrompt,sizeof(nanoPrompt),"Overwrite this saved game?\n%s",name);
+    msgBox.SetMessage(nanoPrompt);msgBox.onPositive=VoidCb(&CMenuLoadGame::NanoCommitSave);msgBox.Show();
+}
+void CMenuLoadGame::NanoCommitSave()
+{
+    if(!CL_IsActive() || gpGlobals->maxClients>1 || !NanoSaveNameValid(nanoTarget))return;
+    char command[128];NanoUnloadPreviews();
+    snprintf(command,sizeof(command),"save \"%s\"\n",nanoTarget);
+    EngFuncs::ClientCmd(false,command);UI_CloseMenu();
+}
+void CMenuLoadGame::NanoRequestDelete()
+{
+    int index=savesList.GetCurrentIndex();
+    if(!savesListModel.IsValidIndex(index))return;
+    const char *name=savesListModel[index].name;
+    if(!strcmp(name,"new") || !NanoSaveNameValid(name))return;
+    Q_strncpy(nanoTarget,name,sizeof(nanoTarget));
+    snprintf(nanoPrompt,sizeof(nanoPrompt),"Delete this saved game?\n%s",name);
+    msgBox.SetMessage(nanoPrompt);msgBox.onPositive=VoidCb(&CMenuLoadGame::NanoCommitDelete);msgBox.Show();
+}
+void CMenuLoadGame::NanoCommitDelete()
+{
+    if(!strcmp(nanoTarget,"new") || !NanoSaveNameValid(nanoTarget))return;
+    char command[128];int selected=savesList.GetCurrentIndex();
+    NanoUnloadPreviews();snprintf(command,sizeof(command),"killsave \"%s\"\n",nanoTarget);
+    EngFuncs::ClientCmd(true,command);savesListModel.Update();
+    savesList.SetCurrentIndex(Q_min(selected,Q_max(0,savesListModel.Count()-1)));
+}
+bool CMenuLoadGame::KeyDown(int key)
+{
+    if(!NanoMenuEnabled())return BaseClass::KeyDown(key);
+    if(msgBox.IsVisible())return msgBox.KeyDown(key);
+    if(UI::Key::IsEscape(key) || key==K_SPACE){Hide();return true;}
+    int selected=savesList.GetCurrentIndex(),count=savesListModel.Count();
+    if(UI::Key::IsUpArrow(key) || UI::Key::IsDownArrow(key)) {
+        savesList.SetCurrentIndex(bound(0,selected+(UI::Key::IsDownArrow(key)?1:-1),Q_max(0,count-1)));
+        PlayLocalSound(uiStatic.sounds[SND_MOVE]);return true;
+    }
+    if(UI::Key::IsEnter(key)) {
+        if(savesListModel.IsValidIndex(selected) && strcmp(savesListModel[selected].name,"new"))LoadGame();
+        return true;
+    }
+    if(key==K_F8 || key=='v' || key==K_X_BUTTON){NanoRequestSave();return true;}
+    if(key==K_F9 || key=='e' || key==K_Y_BUTTON){NanoRequestDelete();return true;}
+    return true;
+}
+bool CMenuLoadGame::KeyUp(int key)
+{
+    return NanoMenuEnabled()?true:BaseClass::KeyUp(key);
+}
+void CMenuLoadGame::Draw()
+{
+    if(!NanoMenuEnabled()){BaseClass::Draw();return;}
+    DisableTransition();NanoThemeBevel(8,4,ScreenWidth-16,ScreenHeight-8,NanoThemePanel());
+    SetNanoFont(14);
+    UI_DrawString(font,16,14,ScreenWidth-32,20,"Save/Load Game",uiPromptTextColor,14,QM_LEFT,ETF_SHADOW|ETF_FORCECOL);
+    UI_FillRect(16,37,ScreenWidth-32,1,NanoThemeDark());SetNanoFont(12);
+    int count=savesListModel.Count(),selected=savesList.GetCurrentIndex();
+    nanoSaveStart=NanoSaveWindow(selected,count,nanoSaveStart);
+    // Free the previous window before loading a shifted window: CImage has no
+    // reference counting, and two slots may otherwise alias the same texture.
+    for(int slot=0;slot<3;++slot) {
+        int index=nanoSaveStart+slot;
+        const char *name=index<count?savesListModel[index].name:"";
+        if(strcmp(nanoThumbName[slot],name)){NanoUnloadPreviews();break;}
+    }
+    for(int slot=0;slot<3;++slot) {
+        int index=nanoSaveStart+slot,y=44+slot*51;
+        if(index>=count){nanoThumb[slot].ForceUnload();nanoThumb[slot].Reset();nanoThumbName[slot][0]=0;continue;}
+        save_t &entry=savesListModel[index];bool create=!strcmp(entry.name,"new");
+        UI_FillRect(16,y,ScreenWidth-32,48,NanoThemeField());
+        if(index==selected)UI_DrawRectangleExt(16,y,ScreenWidth-32,48,uiPromptFocusColor,1);
+        if(strcmp(nanoThumbName[slot],entry.name)) {
+            nanoThumb[slot].ForceUnload();Q_strncpy(nanoThumbName[slot],entry.name,sizeof(nanoThumbName[slot]));
+            snprintf(nanoThumbPath[slot],sizeof(nanoThumbPath[slot]),"save/%s.bmp",entry.name);
+            if(!create && EngFuncs::FileExists(nanoThumbPath[slot],true))nanoThumb[slot].Load(nanoThumbPath[slot]);
+        }
+        if(nanoThumb[slot].IsValid()) {
+            int w=42,h=42,iw=EngFuncs::PIC_Width(nanoThumb[slot].Handle()),ih=EngFuncs::PIC_Height(nanoThumb[slot].Handle());
+            if(iw>0 && ih>0){h=Q_max(1,w*ih/iw);if(h>42){h=42;w=Q_max(1,h*iw/ih);}}
+            UI_DrawPic(19+(42-w)/2,y+3+(42-h)/2,w,h,uiColorWhite,nanoThumb[slot]);
+        } else {
+            NanoThemeBevel(19,y+3,42,42,NanoThemeField(),true);
+            UI_DrawString(font,19,y+3,42,42,create?"+":"?",uiColorHelp,12,QM_CENTER,ETF_FORCECOL);
+        }
+        const char *name=create?"New save":!stricmp(entry.name,"quick")?"Quick save":!stricmp(entry.name,"autosave")?"Autosave":entry.name;
+        char fitted[256];int width=ScreenWidth-88;
+        NanoMenuFit(font,name,fitted,sizeof(fitted),width,12);
+        UI_DrawString(font,70,y+3,width,14,fitted,uiPromptTextColor,12,QM_LEFT,ETF_FORCECOL);
+        const char *context=create?(CL_IsActive()?"Create a new slot":"Start a game to save"):entry.comment[0]?entry.comment:entry.date;
+        NanoMenuFit(font,context,fitted,sizeof(fitted),width,12);
+        UI_DrawString(font,70,y+17,width,14,fitted,uiColorHelp,12,QM_LEFT,ETF_FORCECOL);
+        if(!create){NanoMenuFit(font,entry.elapsed_time,fitted,sizeof(fitted),width,12);
+            UI_DrawString(font,70,y+31,width,14,fitted,uiColorHelp,12,QM_LEFT,ETF_FORCECOL);}
+    }
+    bool create=savesListModel.IsValidIndex(selected) && !strcmp(savesListModel[selected].name,"new");
+    bool playing=CL_IsActive() && gpGlobals->maxClients<2;
+    UI_DrawString(font,16,ScreenHeight-33,100,14,"A Load",create?uiColorHelp:uiPromptFocusColor,12,QM_LEFT,ETF_FORCECOL);
+    UI_DrawString(font,16,ScreenHeight-19,100,14,"Y Delete",create?uiColorHelp:uiPromptTextColor,12,QM_LEFT,ETF_FORCECOL);
+    UI_DrawString(font,ScreenWidth-116,ScreenHeight-33,100,14,create?"X Save":"X Overwrite",playing?uiPromptFocusColor:uiColorHelp,12,QM_RIGHT,ETF_FORCECOL);
+    UI_DrawString(font,ScreenWidth-116,ScreenHeight-19,100,14,"B Back",uiPromptTextColor,12,QM_RIGHT,ETF_FORCECOL);
+}
