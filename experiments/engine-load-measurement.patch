+#include <unistd.h>
+
+/* Temporary load measurement; not part of the ordinary native recipe. */
+typedef struct { unsigned long long minor, major; long long rss, up; int valid; } nano_load_snapshot_t;
+static double nanoLoadStart;
+static unsigned nanoLoadSeq;
+static int nanoLoadPending;
+static char nanoLoadOp[32];
+static nano_load_snapshot_t nanoLoadBefore;
+static nano_load_snapshot_t NanoLoadSnapshot( void )
+{
+    nano_load_snapshot_t s = {0};
+    char buf[2048], *p; FILE *f = fopen("/proc/self/stat", "r");
+    if (f) {
+        if (fgets(buf, sizeof(buf), f) && (p = strrchr(buf, ')'))) {
+            p += 2;
+            for (int field = 3; field <= 24 && *p; field++) {
+                if (field == 10) s.minor = strtoull(p, NULL, 10);
+                if (field == 12) s.major = strtoull(p, NULL, 10);
+                if (field == 24) { s.rss = strtoll(p, NULL, 10) * (sysconf(_SC_PAGESIZE) / 1024); s.valid = 1; }
+                while (*p && *p != ' ') p++;
+                while (*p == ' ') p++;
+            }
+        }
+        fclose(f);
+    }
+    f = fopen("/proc/uptime", "r");
+    if (f) { double up = 0; if (fscanf(f, "%lf", &up) == 1) s.up = (long long)(up * 1000); fclose(f); }
+    return s;
+}
+void NanoLoadProbeBegin( const char *op )
+{
+    nanoLoadBefore = NanoLoadSnapshot();
+    Q_strncpy(nanoLoadOp, op, sizeof(nanoLoadOp));
+    nanoLoadSeq++; nanoLoadPending = 1;
+    fprintf(stderr, "nano-load-begin: seq=%u op=%s up_ms=%lld rss_kib=%lld\n", nanoLoadSeq, nanoLoadOp, nanoLoadBefore.up, nanoLoadBefore.rss);
+    nanoLoadStart = Platform_DoubleTime();
+}
+void NanoLoadProbeReady( void )
+{
+    if (!nanoLoadPending) return;
+    const double elapsed = Platform_DoubleTime() - nanoLoadStart;
+    const nano_load_snapshot_t s = NanoLoadSnapshot();
+    fprintf(stderr, "nano-load-ready: seq=%u op=%s duration_ms=%.3f start_up_ms=%lld end_up_ms=%lld valid=%d minflt=%llu majflt=%llu rss_before_kib=%lld rss_after_kib=%lld\n",
+        nanoLoadSeq, nanoLoadOp, elapsed * 1000, nanoLoadBefore.up, s.up, s.valid && nanoLoadBefore.valid,
+        s.minor - nanoLoadBefore.minor, s.major - nanoLoadBefore.major, nanoLoadBefore.rss, s.rss);
+    nanoLoadPending = 0;
+}
